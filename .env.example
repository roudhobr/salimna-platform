# ==============================================================================
# SALIMNA PLATFORM - ENVIRONMENT VARIABLES
# ==============================================================================

# Konfigurasi Server Backend
PORT=5000
NODE_ENV=development
SERVE_CLIENT=false

# Konfigurasi Supabase
# Dapatkan kredensial ini di Dashboard Supabase: Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Secret HMAC untuk link portal nota (minimal 32 byte acak)
ORDER_RECEIPT_SECRET=replace-with-at-least-32-random-bytes

# Daftar email akun Supabase Auth yang boleh mengakses panel admin
ADMIN_EMAILS=admin@example.com

# Konfigurasi Frontend Vite
VITE_API_URL=/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
