# ==============================================================================
# SALIMNA PLATFORM - ENVIRONMENT VARIABLES
# ==============================================================================

# Konfigurasi Server Backend
PORT=5000
NODE_ENV=development

# Konfigurasi Supabase
# Dapatkan kredensial ini di Dashboard Supabase: Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# Opsional jika menggunakan Service Role (untuk bypassing RLS di server backend):
SUPABASE_SERVICE_ROLE_KEY=

# Konfigurasi Fonnte WhatsApp
FONNTE_API_KEY=

# Konfigurasi Frontend Vite
VITE_API_URL=/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
